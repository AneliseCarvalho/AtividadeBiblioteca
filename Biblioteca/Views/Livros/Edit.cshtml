@model Biblioteca.Models.Livro

@{
    ViewData["Title"] = "Editar Livro";
}

<div class="row">
    <div class="col-1 col-md-2 col-lg-2"></div>
    <div class="col-10 col-md-8 col-lg-8 bg-black text-light m-lg-5 mb-3 p-5">

        <h1 class="text-center mb-5">Editar Livro</h1>

        <div class="row justify-content-center">
            <div class="col-md-10">
                <form asp-action="Edit" enctype="multipart/form-data" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <input type="hidden" asp-for="LivroId" />

                    <div class="mb-3">
                        <label asp-for="Titulo" class="form-label"></label>
                        <input asp-for="Titulo" class="form-control" />
                        <span asp-validation-for="Titulo" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Autor" class="form-label"></label>
                        <input asp-for="Autor" class="form-control" />
                        <span asp-validation-for="Autor" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Descricao" class="form-label"></label>
                        <input asp-for="Descricao" class="form-control" />
                        <span asp-validation-for="Descricao" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Editora" class="form-label"></label>
                        <input asp-for="Editora" class="form-control" />
                        <span asp-validation-for="Editora" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="DataPublicacao" class="form-label"></label>
                        <input asp-for="DataPublicacao" class="form-control" type="date" />
                        <span asp-validation-for="DataPublicacao" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NumeroPaginas" class="form-label"></label>
                        <input asp-for="NumeroPaginas" class="form-control" />
                        <span asp-validation-for="NumeroPaginas" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Quantidade" class="form-label"></label>
                        <input asp-for="Quantidade" class="form-control" />
                        <span asp-validation-for="Quantidade" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Capa Atual</label><br />
                        @if (!string.IsNullOrEmpty(Model.UrlCapa))
                        {
                            <img src="@Model.UrlCapa" alt="Capa do Livro" class="img-thumbnail mb-2" style="max-height: 180px;" />
                        }
                        else
                        {
                            <span class="text-muted">Nenhuma capa cadastrada.</span>
                        }
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Trocar Capa do Livro</label>
                        <input type="file" name="capaUpload" class="form-control" accept="image/*" />
                        <span asp-validation-for="UrlCapa" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ISBN10" class="form-label"></label>
                        <input asp-for="ISBN10" class="form-control" />
                        <span asp-validation-for="ISBN10" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ISBN13" class="form-label"></label>
                        <input asp-for="ISBN13" class="form-control" />
                        <span asp-validation-for="ISBN13" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="GeneroId" class="form-label"></label>
                        <select asp-for="GeneroId" class="form-control" asp-items="ViewBag.GeneroId"></select>
                        <span asp-validation-for="GeneroId" class="text-danger"></span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-save"></i> Salvar
                        </button>
                        <a asp-action="Index" class="btn btn-outline-light">
                            <i class="bi bi-arrow-left"></i> Voltar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-1 col-md-2 col-lg-2"></div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}