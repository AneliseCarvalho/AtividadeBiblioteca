@model Biblioteca.Models.Livro

@{
    ViewData["Title"] = "Excluir Livro";
}

<div class="row">
    <div class="col-1 col-md-2 col-lg-2"></div>
    <div class="col-10 col-md-8 col-lg-8 bg-black text-light m-lg-5 mb-3 p-5">

        <h1 class="text-center mb-5 text-danger">Excluir Livro</h1>

        <div class="alert alert-warning text-dark text-center mb-4">
            <h4 class="mb-0"><i class="bi bi-exclamation-triangle"></i> Tem certeza que deseja excluir este livro?</h4>
        </div>

        <div class="row justify-content-center mb-4">
            <div class="col-md-10">
                <div class="card bg-dark text-light shadow mb-3">
                    <div class="row g-0">
                        <div class="col-md-4 d-flex align-items-center justify-content-center p-3">
                            @if (!string.IsNullOrEmpty(Model.UrlCapa))
                            {
                                <img src="@Url.Action("BuscarCapa", "Livros", new { id = Model.LivroId })"
                                     alt="Capa do Livro"
                                     class="img-fluid rounded shadow"
                                     style="max-height: 220px; object-fit: contain;" />
                            }
                            else
                            {
                                <span class="text-muted">Nenhuma capa cadastrada.</span>
                            }
                        </div>
                        <div class="col-md-8">
                            <div class="card-body">
                                <h4 class="card-title mb-3">@Model.Titulo</h4>
                                <p class="mb-1"><strong>@Html.DisplayNameFor(m => m.Autor):</strong> @Model.Autor</p>
                                <p class="mb-1"><strong>@Html.DisplayNameFor(m => m.Editora):</strong> @Model.Editora</p>
                                <p class="mb-1"><strong>@Html.DisplayNameFor(m => m.DataPublicacao):</strong> @Model.DataPublicacao.ToString("dd/MM/yyyy")</p>
                                <p class="mb-1"><strong>@Html.DisplayNameFor(m => m.NumeroPaginas):</strong> @Model.NumeroPaginas</p>
                                <p class="mb-1"><strong>@Html.DisplayNameFor(m => m.Quantidade):</strong> @Model.Quantidade</p>
                                <p class="mb-1"><strong>@Html.DisplayNameFor(m => m.ISBN10):</strong> @Model.ISBN10</p>
                                <p class="mb-1"><strong>@Html.DisplayNameFor(m => m.ISBN13):</strong> @Model.ISBN13</p>
                                <p class="mb-1"><strong>@Html.DisplayNameFor(m => m.Genero):</strong> @(Model.Genero?.Nome ?? "-")</p>
                                <hr class="bg-secondary" />
                                <p class="mb-0"><strong>@Html.DisplayNameFor(m => m.Descricao):</strong> @Model.Descricao</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row justify-content-center">
            <div class="col-md-10">
                <form asp-action="Delete">
                    <input type="hidden" asp-for="LivroId" />
                    <div class="d-flex justify-content-between">
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash3"></i> Excluir
                        </button>
                        <a asp-action="Index" class="btn btn-outline-light">
                            <i class="bi bi-arrow-left"></i> Voltar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-1 col-md-2 col-lg-2"></div>
</div>