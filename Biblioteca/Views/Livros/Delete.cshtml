@model Biblioteca.Models.Livro

@{
    ViewData["Title"] = "Excluir Livro";
}

<div class="row">
    <div class="col-1 col-md-2 col-lg-2"></div>
    <div class="col-10 col-md-8 col-lg-8 bg-black text-light m-lg-5 mb-3 p-5">

        <h1 class="text-center mb-5 text-danger">Excluir Livro</h1>

        <div class="alert alert-warning text-dark text-center mb-4">
            <h4 class="mb-0"><i class="bi bi-exclamation-triangle"></i> Tem certeza que deseja excluir este livro?</h4>
        </div>

        <div class="row justify-content-center mb-4">
            <div class="col-md-10">
                <dl class="row">
                    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Titulo)</dt>
                    <dd class="col-sm-9">@Html.DisplayFor(model => model.Titulo)</dd>
                    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Autor)</dt>
                    <dd class="col-sm-9">@Html.DisplayFor(model => model.Autor)</dd>
                    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Descricao)</dt>
                    <dd class="col-sm-9">@Html.DisplayFor(model => model.Descricao)</dd>
                    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Editora)</dt>
                    <dd class="col-sm-9">@Html.DisplayFor(model => model.Editora)</dd>
                    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DataPublicacao)</dt>
                    <dd class="col-sm-9">@Html.DisplayFor(model => model.DataPublicacao)</dd>
                    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NumeroPaginas)</dt>
                    <dd class="col-sm-9">@Html.DisplayFor(model => model.NumeroPaginas)</dd>
                    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Quantidade)</dt>
                    <dd class="col-sm-9">@Html.DisplayFor(model => model.Quantidade)</dd>
                    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.UrlCapa)</dt>
                    <dd class="col-sm-9">
                        @if (!string.IsNullOrEmpty(Model.UrlCapa))
                        {
                            <img src="@Model.UrlCapa" alt="Capa do Livro" class="img-thumbnail mb-2" style="max-height: 120px;" />
                        }
                        else
                        {
                            <span class="text-muted">Nenhuma capa cadastrada.</span>
                        }
                    </dd>
                    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ISBN10)</dt>
                    <dd class="col-sm-9">@Html.DisplayFor(model => model.ISBN10)</dd>
                    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ISBN13)</dt>
                    <dd class="col-sm-9">@Html.DisplayFor(model => model.ISBN13)</dd>
                    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Genero)</dt>
                    <dd class="col-sm-9">@Html.DisplayFor(model => model.Genero.GeneroId)</dd>
                </dl>
            </div>
        </div>

        <div class="row justify-content-center">
            <div class="col-md-10">
                <form asp-action="Delete">
                    <input type="hidden" asp-for="LivroId" />
                    <div class="d-flex justify-content-between">
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash3"></i> Excluir
                        </button>
                        <a asp-action="Index" class="btn btn-outline-light">
                            <i class="bi bi-arrow-left"></i> Voltar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-1 col-md-2 col-lg-2"></div>
</div>