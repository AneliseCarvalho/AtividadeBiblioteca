@model Biblioteca.Models.Genero

@{
    ViewData["Title"] = "Create";
}

<h1>Criar</h1>

<h4>Gênero</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Nome" class="control-label"></label>
                <input asp-for="Nome" class="form-control" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Criar" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index" style="display:inline-block; margin-top:12px; padding:12px 24px; background:#00d1d2; color:#fff; border-radius:8px; text-decoration:none; text-align:center;">Voltar para a lista</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
