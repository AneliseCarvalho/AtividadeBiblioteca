@model Biblioteca.Models.Usuario
@{
    ViewData["Title"] = "Cadastro de Usuário";
}

<div class="row">
    <div class="col-1 col-md-2 col-lg-2"></div>
    <div class="col-10 col-md-8 col-lg-8 bg-black text-light m-lg-5 mb-3 p-5">

        <h1 class="text-center mb-5">Editar Usuário</h1>

        <form asp-action="Edit" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <input type="hidden" asp-for="UsuarioId" />

            <div class="row mb-3">
                <div class="col-md-8">
                    <div class="mb-3">
                        <label asp-for="NomeCompleto" class="form-label"></label>
                        <input asp-for="NomeCompleto" class="form-control" />
                        <span asp-validation-for="NomeCompleto" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-4 text-center">
                    <label class="form-label">Foto Atual</label>
                    <div>
                        @if (!string.IsNullOrEmpty(Model.UrlFoto))
                        {
                            <img src="@Model.UrlFoto" alt="Foto do Usuário" class="img-thumbnail mb-2" style="width: 100px; height: 100px; object-fit: cover;" />
                        }
                        else
                        {
                            <span class="text-muted">Sem foto</span>
                        }
                    </div>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="CPF" class="form-label"></label>
                    <input asp-for="CPF" class="form-control" />
                    <span asp-validation-for="CPF" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Celular" class="form-label"></label>
                    <input asp-for="Celular" class="form-control" />
                    <span asp-validation-for="Celular" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="DataNascimento" class="form-label"></label>
                    <input type="date" asp-for="DataNascimento" class="form-control" />
                    <span asp-validation-for="DataNascimento" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="UrlFoto" class="form-label">Trocar Foto</label>
                    <input type="file" asp-for="UrlFoto" class="form-control" accept="image/*" />
                    <span asp-validation-for="UrlFoto" class="text-danger"></span>
                </div>
            </div>

            <input type="hidden" asp-for="AppUserId" />

            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Index" class="btn btn-outline-light fs-5">
                    <i class="bi bi-arrow-left"></i> Voltar
                </a>
                <button type="submit" id="btnSalvar" class="btn btn-success fs-5">
                    <i class="bi bi-floppy"></i> Salvar
                </button>
            </div>
        </form>
    </div>
    <div class="col-1 col-md-2 col-lg-2"></div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function () {
            // Aplica a máscara ao campo CPF
            $('input[name="CPF"]').mask('000.000.000-00');
            // Aplica a máscara ao campo Celular
            $('input[name="Celular"]').mask('(00) 00000-0000');
        });
    </script>
}